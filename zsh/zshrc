# Runs for INTERACTIVE shells only
#
# performance testing
# PS4=$'\\\011%D{%s%6.}\011%x\011%I\011%N\011%e\011'
# exec 3>&2 2>/tmp/zshstart.$$.log
# setopt xtrace prompt_subst
# zmodload zsh/zprof

# DOT_OS, ZSH_CONF_DIR, insert_path/append_path, and env.d/*.sh
# (PATH/exports/functions needed by every shell) are set up in zshenv,
# which runs before this file for interactive shells too.

setopt aliases

export EDITOR="nvim"
export VISUAL="zed"
export COLORTERM="truecolor"

if [ -z $TMUX ]; then
    if [[ "$TERM" = "xterm-256color" ]]; then
        :
    else
        tmux new-session -A -s main -n ''
    fi
fi

ulimit -n 4096

# use emacs style, not vim
bindkey -e

bindkey "^[[1;5D" backward-word     # Ctrl+Left
bindkey "^[[1;5C" forward-word      # Ctrl+Right
bindkey "^[[1~" beginning-of-line   # Fn+Left (Home)
bindkey "^[[4~" end-of-line         # Fn+Right (End)
bindkey "^[[3~" delete-char         # Fn+Delete

# zinit plugins and turbo loading
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
[ ! -d $ZINIT_HOME ] && mkdir -p "$(dirname $ZINIT_HOME)"
[ ! -d $ZINIT_HOME/.git ] && git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
source "${ZINIT_HOME}/zinit.zsh"

zinit wait lucid for \
 atinit"ZINIT[COMPINIT_OPTS]=-C; zicompinit; zicdreplay" \
    zdharma-continuum/fast-syntax-highlighting \
 blockf \
    zsh-users/zsh-completions \
 atload"!_zsh_autosuggest_start" \
    zsh-users/zsh-autosuggestions

eval "$(starship init zsh)"
eval "$(/opt/homebrew/bin/brew shellenv)"

for f in "$HOME"/.config/zsh/rc.d/*.sh; do
    source "$f"
done

